# ========== DATABASE CONFIGURATION ==========
# PostgreSQL Connection String (Railway fornecerá automaticamente)
# Formato: postgresql://user:password@host:port/database
# Em Railway, use a variável gerada automaticamente
DATABASE_URL=postgresql://user:password@localhost:5432/ev_opportunities

# ========== API KEYS ==========
# SofaScore API (geralmente gratuita, pode não precisar de chave)
SOFASCORE_API_KEY=

# Sportmonks Football API (necessário para dados avançados)
# Consiga em: https://www.sportmonks.com/football-api
SPORTMONKS_API_KEY=

# ========== SYSTEM CONFIGURATION ==========
# Ambiente (development ou production)
NODE_ENV=production

# Logging (debug mode)
DEBUG=false

# ========== OPTIONAL: BETFAIR/PINNACLE ==========
